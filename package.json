{
  "name": "flowplan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "check:release-age": "node scripts/check-release-age.ts",
    "schema:write": "node packages/core/scripts/write-json-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
